{
  "name": "@mzebley/canvas-watch",
  "version": "1.1.0",
  "type": "module",
  "description": "Track canvas overlap and reactive vertical viewport state with a framework-agnostic core and optional Svelte adapter.",
  "author": "Mark Zebley",
  "license": "ISC",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "workspaces": [
    "site"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "import": "./dist/svelte/index.js",
      "require": "./dist/svelte/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "build:core": "tsup",
    "test": "npm run build:core && node --test",
    "verify:package": "node scripts/verify-package.mjs",
    "profile:library": "npm run build:core && node scripts/profile-performance.mjs",
    "verify:site-demo": "node scripts/verify-site-demo.mjs",
    "verify": "npm test && npm run site:build && npm run verify:site-demo && npm run verify:package && git diff --check",
    "demo": "npm run build:core && npx --yes serve .",
    "site:dev": "npm run dev --workspace site",
    "site:build": "npm run build --workspace site",
    "site:preview": "npm run preview --workspace site",
    "prepare": "npm run build"
  },
  "keywords": [
    "intersection-observer",
    "viewport",
    "scroll",
    "background",
    "shadow",
    "contrast",
    "svelte",
    "svelte-action",
    "liquid-glass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzebley/canvas-watch.git"
  },
  "bugs": {
    "url": "https://github.com/mzebley/canvas-watch/issues"
  },
  "homepage": "https://canvas-watch.markzebley.com",
  "peerDependencies": {
    "svelte": ">=5.7"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "playwright": "^1.62.1",
    "svelte": "^5.7.0",
    "tsup": "^8.3.0",
    "typescript": "~5.5.4"
  }
}
