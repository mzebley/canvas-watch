{
  "name": "canvas-watch-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page, docs, and live demo for @mzebley/canvas-watch.",
  "scripts": {
    "lib": "npm run build:core --prefix ..",
    "tokens": "zebkit build",
    "tokens:clean": "rm -f static/*.prune-report.json static/zebkit-a11y-input.json",
    "predev": "npm run lib && npm run tokens",
    "dev": "vite dev",
    "prebuild": "npm run lib && npm run tokens && npm run tokens:clean",
    "build": "vite build",
    "preview": "vite preview",
    "check:zebkit": "zebkit build && zebkit check"
  },
  "devDependencies": {
    "@angular/common": "^18.2.14",
    "@angular/compiler": "^18.2.14",
    "@angular/core": "^18.2.14",
    "@angular/platform-browser": "^18.2.14",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "lit": "^3.3.2",
    "rxjs": "^7.8.2",
    "shiki": "^4.4.1",
    "svelte": "^5.0.0",
    "tslib": "^2.8.1",
    "vite": "^7.3.6",
    "zebkit": "npm:@mzebley/zebkit@0.11.1",
    "zone.js": "^0.14.10"
  }
}
