{
  "$schema": "../node_modules/zebkit/dist/editor/schemas/zebkit.config.schema.json",
  "configVersion": 3,
  "tokens": {
    "destinationPath": "./static",
    "assetFilePath": "/",
    "minify": true,
    "prune": {
      "enabled": true,
      "content": ["./src/**/*.svelte", "./src/**/*.js", "./src/**/*.css", "./src/app.html"],
      "safelist": ["/^zbk-/", "/^over-/", "/^cw-/"],
      "output": { "mode": "replace" }
    }
  },
  "theme": {
    "name": "canvas-watch",
    "preset": "default",
    "tokenPath": "./tokens",
    "options": { "colorScheme": "light" },
    "fonts": { "strategy": "link" },
    "overlays": [
      {
        "name": "dark",
        "tokenPath": "./themes/dark",
        "options": { "colorScheme": "dark" }
      }
    ]
  },
  "runtime": {
    "path": "./src/lib/zebkit/zebkit.runtime.js"
  },
  "context": {
    "path": "./zebkit/context"
  },
  "check": {
    "content": ["./src/**/*.svelte", "./src/app.html"]
  },
  "accessibility": {
    "delivery": "auto",
    "verify": {
      "routes": [{ "id": "landing", "path": "/" }],
      "viewports": [
        { "id": "mobile", "width": 375, "height": 812 },
        { "id": "desktop", "width": 1440, "height": 1000 },
        { "id": "reflow", "width": 320, "height": 800, "reflow": true }
      ],
      "themes": [
        { "id": "light", "selector": "html", "attribute": "data-zbk-theme", "value": "light" },
        { "id": "dark", "selector": "html", "attribute": "data-zbk-theme", "value": "dark" }
      ]
    }
  }
}
